{
  "name": "plantx",
  "version": "3.7.0",
  "private": true,
  "packageManager": "npm@11.16.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:generate": "npm run generate -w @plantx/db",
    "db:push": "npm run db:push -w @plantx/db",
    "db:migrate": "npm run db:migrate -w @plantx/db",
    "seed": "npm run seed -w @plantx/db",
    "backfill:logistic-flows": "npm run backfill:logistic-flows -w @plantx/db",
    "desktop:build": "node scripts/desktop-build.mjs",
    "desktop:run": "electron apps/desktop/dist",
    "desktop:dev": "node scripts/desktop-build.mjs && electron apps/desktop/dist",
    "desktop:dist": "electron-builder --config electron-builder.yml",
    "desktop:release": "node scripts/desktop-build.mjs && electron-builder --config electron-builder.yml"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "tsx": "^4.21.0",
    "turbo": "^2.0.0",
    "typescript": "^5"
  }
}
