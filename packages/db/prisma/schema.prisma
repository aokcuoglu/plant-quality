model OrganizationUnit {
  id                    String                 @id @default(uuid())
  name                  String
  type                  OrgUnitType
  companyId             String
  company               Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parentId              String?
  parent                OrganizationUnit?      @relation("OrgTree", fields: [parentId], references: [id], onDelete: SetNull)
  children              OrganizationUnit[]     @relation("OrgTree")
  users                 User[]
  logisticWorkflowNodes LogisticWorkflowNode[] @relation("WorkflowNodeOrganizationUnit")
  logisticWorkflowTasks LogisticWorkflowTask[] @relation("WorkflowTaskOrganizationUnit")
  sortOrder             Int                    @default(0)
  createdAt             DateTime               @default(now())

  @@index([companyId, parentId])
  @@map("organization_units")
}

model Company {
  id                          String                             @id @default(uuid())
  name                        String
  type                        CompanyType
  plan                        Plan                               @default(FREE)
  modules                     String[]                           @default([])
  ssoEnabled                  Boolean                            @default(false) @map("sso_enabled")
  microsoftTenantIds          String[]                           @default([]) @map("microsoft_tenant_ids")
  ssoAllowedDomains           String[]                           @default([]) @map("sso_allowed_domains")
  planStatus                  String?                            @map("plan_status")
  planStartedAt               DateTime?                          @map("plan_started_at")
  trialEndsAt                 DateTime?                          @map("trial_ends_at")
  taxNumber                   String?
  primaryOemId                String?                            @map("primary_oem_id")
  primaryOem                  Company?                           @relation("SupplierPrimaryOem", fields: [primaryOemId], references: [id])
  linkedSuppliers             Company[]                          @relation("SupplierPrimaryOem")
  users                       User[]
  orgUnits                    OrganizationUnit[]
  defectsAsOem                Defect[]                           @relation("OemDefects")
  defectsAsSup                Defect[]                           @relation("SupplierDefects")
  ppapAsOem                   PpapSubmission[]                   @relation("OemPpapSubmissions")
  ppapAsSup                   PpapSubmission[]                   @relation("SupplierPpapSubmissions")
  iqcAsOem                    IqcReport[]                        @relation("OemIqcReports")
  iqcAsSup                    IqcReport[]                        @relation("SupplierIqcReports")
  fmeaAsOem                   Fmea[]                             @relation("OemFmeas")
  fmeaAsSup                   Fmea[]                             @relation("SupplierFmeas")
  fieldDefectsAsOem           FieldDefect[]                      @relation("FieldDefectOem")
  fieldDefectsAsSup           FieldDefect[]                      @relation("FieldDefectSupplier")
  aiSuggestions               AiSuggestion[]
  notifications               Notification[]
  escalationHistory           EscalationHistory[]
  ai8dReviews                 Ai8dReview[]
  usageCounters               UsageCounter[]
  upgradeRequests             UpgradeRequest[]
  qualityRecordLinks          QualityRecordLink[]
  devPlansAsOem               SupplierDevelopmentPlan[]          @relation("DevPlansAsOem")
  devPlansAsSupplier          SupplierDevelopmentPlan[]          @relation("DevPlansAsSupplier")
  logisticOrders              PlantLogisticOrder[]               @relation("LogisticOrdersOem")
  logisticOrderEvents         PlantLogisticOrderEvent[]          @relation("LogisticOrderEventsOem")
  productionMilestones        PlantLogisticProductionMilestone[] @relation("MilestoneCompany")
  yardStatuses                PlantLogisticYardStatus[]          @relation("YardStatusCompany")
  dispatches                  PlantLogisticDispatch[]            @relation("DispatchCompany")
  logisticOrdersAsDealer      PlantLogisticOrder[]               @relation("LogisticOrdersDealer")
  logisticOrdersAsDistributor PlantLogisticOrder[]               @relation("LogisticOrdersDistributor")
  planSheets                  PlantLogisticPlanSheet[]           @relation("PlanSheetCompany")
  planSheetLines              PlantLogisticPlanSheetLine[]       @relation("PlanSheetLineCompany")
  planSheetEvents             PlantLogisticPlanSheetEvent[]      @relation("PlanSheetEventCompany")
  vehicleGroups               LogisticVehicleGroup[]
  vehicleModels               LogisticVehicleModel[]
  logisticProcesses           LogisticProcess[]
  logisticFlowVersions        LogisticFlowVersion[]
  logisticOrderLines          LogisticOrderLine[]
  logisticVehicleUnits        LogisticVehicleUnit[]
  logisticVehicleVisits       LogisticVehicleProcessVisit[]
  logisticWorkflowDefinitions LogisticWorkflowDefinition[]
  logisticWorkflowVersions    LogisticWorkflowVersion[]
  logisticWorkflowNodes       LogisticWorkflowNode[]
  logisticWorkflowEdges       LogisticWorkflowEdge[]
  logisticWorkflowInstances   LogisticWorkflowInstance[]
  logisticWorkflowTasks       LogisticWorkflowTask[]
  logisticWorkflowEvents      LogisticWorkflowEvent[]
  customFieldDefinitions      CustomFieldDefinition[]
  scorecardConfig             SupplierScorecardConfig?
  createdAt                   DateTime                           @default(now())

  @@map("companies")
}

model User {
  id                        String                             @id @default(uuid())
  email                     String                             @unique
  name                      String?
  emailVerified             DateTime?
  image                     String?
  role                      Role                               @default(VIEWER)
  plan                      Plan                               @default(BASIC)
  modules                   String[]                           @default([])
  microsoftId               String?                            @map("microsoft_id")
  graphDepartment           String?                            @map("graph_department")
  graphJobTitle             String?                            @map("graph_job_title")
  graphManagerEmail         String?                            @map("graph_manager_email")
  companyId                 String?
  company                   Company?                           @relation(fields: [companyId], references: [id])
  orgUnitId                 String?                            @map("org_unit_id")
  orgUnit                   OrganizationUnit?                  @relation(fields: [orgUnitId], references: [id], onDelete: SetNull)
  accounts                  Account[]
  sessions                  Session[]
  reviewComments            ReviewComment[]
  resolvedReviewComments    ReviewComment[]                    @relation("ReviewCommentResolvedBy")
  approvedReports           EightDReport[]                     @relation("EightDApprovedBy")
  rejectedReports           EightDReport[]                     @relation("EightDRejectedBy")
  ownedDefects              Defect[]                           @relation("DefectOemOwner")
  assignedDefects           Defect[]                           @relation("DefectSupplierAssignee")
  escalatedDefects          Defect[]                           @relation("DefectEscalatedBy")
  defectEvents              DefectEvent[]                      @relation("DefectEventActor")
  uploadedEvidence          DefectEvidence[]                   @relation("DefectEvidenceUploadedBy")
  notifications             Notification[]
  ownedPpaps                PpapSubmission[]                   @relation("PpapOemOwner")
  assignedPpaps             PpapSubmission[]                   @relation("PpapSupplierAssignee")
  approvedPpaps             PpapSubmission[]                   @relation("PpapApprovedBy")
  rejectedPpaps             PpapSubmission[]                   @relation("PpapRejectedBy")
  reviewedPpaps             PpapSubmission[]                   @relation("PpapReviewedBy")
  ppapEvidenceUploads       PpapEvidence[]                     @relation("PpapEvidenceUploadedBy")
  ppapEvidenceReviewed      PpapEvidence[]                     @relation("PpapEvidenceReviewedBy")
  ppapCommentResolved       PpapReviewComment[]                @relation("PpapCommentResolvedBy")
  ppapCommentAuthored       PpapReviewComment[]                @relation("PpapCommentAuthor")
  ppapEventActors           PpapEvent[]                        @relation("PpapEventActor")
  iqcInspections            IqcReport[]                        @relation("IqcInspector")
  iqcCreatedReports         IqcReport[]                        @relation("IqcCreatedBy")
  iqcCompletedReports       IqcReport[]                        @relation("IqcCompletedBy")
  iqcEventActors            IqcEvent[]                         @relation("IqcEventActor")
  fmeaResponsible           Fmea[]                             @relation("FmeaResponsible")
  fmeaApprovedBy            Fmea[]                             @relation("FmeaApprovedBy")
  fmeaReviewedBy            Fmea[]                             @relation("FmeaReviewedBy")
  fmeaCreatedBy             Fmea[]                             @relation("FmeaCreatedBy")
  fmeaEventActors           FmeaEvent[]                        @relation("FmeaEventActor")
  createdFieldDefects       FieldDefect[]                      @relation("FieldDefectCreatedBy")
  updatedFieldDefects       FieldDefect[]                      @relation("FieldDefectUpdatedBy")
  convertedFieldDefects     FieldDefect[]                      @relation("FieldDefectConvertedBy")
  escalatedFieldDefects     FieldDefect[]                      @relation("FieldDefectEscalatedBy")
  escalationHistories       EscalationHistory[]
  createdUpgradeRequests    UpgradeRequest[]                   @relation("UpgradeRequestCreatedBy")
  resolvedUpgradeRequests   UpgradeRequest[]                   @relation("UpgradeRequestResolvedBy")
  createdAiSuggestions      AiSuggestion[]                     @relation("AiSuggestionCreatedBy")
  acceptedAiSuggestions     AiSuggestion[]                     @relation("AiSuggestionAcceptedBy")
  rejectedAiSuggestions     AiSuggestion[]                     @relation("AiSuggestionRejectedBy")
  fieldDefectAttachments    FieldDefectAttachment[]            @relation("FieldDefectAttachmentUploadedBy")
  fieldDefectComments       FieldDefectComment[]               @relation("FieldDefectCommentAuthor")
  fieldDefectEvents         FieldDefectEvent[]                 @relation("FieldDefectEventActor")
  aiCategoryAppliedByFor    FieldDefect[]                      @relation("FieldDefectAiCategoryAppliedBy")
  createdAi8dReviews        Ai8dReview[]                       @relation("Ai8dReviewCreatedBy")
  reviewedAi8dReviews       Ai8dReview[]                       @relation("Ai8dReviewReviewedBy")
  rejectedAi8dReviews       Ai8dReview[]                       @relation("Ai8dReviewRejectedBy")
  createdQualityLinks       QualityRecordLink[]
  ownedDevPlans             SupplierDevelopmentPlan[]          @relation("DevPlanOwner")
  createdDevPlans           SupplierDevelopmentPlan[]          @relation("DevPlanCreatedBy")
  completedDevPlans         SupplierDevelopmentPlan[]          @relation("DevPlanCompletedBy")
  ownedDevActionItems       SupplierDevelopmentActionItem[]    @relation("DevActionItemOwner")
  devPlanEvents             SupplierDevelopmentEvent[]         @relation("DevPlanEventActor")
  createdLogisticOrders     PlantLogisticOrder[]               @relation("LogisticOrderCreatedBy")
  updatedLogisticOrders     PlantLogisticOrder[]               @relation("LogisticOrderUpdatedBy")
  logisticOrderEvents       PlantLogisticOrderEvent[]          @relation("LogisticOrderEventActor")
  createdMilestones         PlantLogisticProductionMilestone[] @relation("MilestoneCreatedBy")
  updatedMilestones         PlantLogisticProductionMilestone[] @relation("MilestoneUpdatedBy")
  createdYardStatuses       PlantLogisticYardStatus[]          @relation("YardStatusCreatedBy")
  updatedYardStatuses       PlantLogisticYardStatus[]          @relation("YardStatusUpdatedBy")
  createdDispatches         PlantLogisticDispatch[]            @relation("DispatchCreatedBy")
  updatedDispatches         PlantLogisticDispatch[]            @relation("DispatchUpdatedBy")
  portalOrderComments       PlantLogisticOrderComment[]        @relation("PortalOrderCommentAuthor")
  createdPlanSheets         PlantLogisticPlanSheet[]           @relation("PlanSheetCreatedBy")
  reviewedPlanSheets        PlantLogisticPlanSheet[]           @relation("PlanSheetReviewedBy")
  approvedPlanSheets        PlantLogisticPlanSheet[]           @relation("PlanSheetApprovedBy")
  planSheetEvents           PlantLogisticPlanSheetEvent[]      @relation("PlanSheetEventActor")
  publishedWorkflowVersions LogisticWorkflowVersion[]          @relation("WorkflowVersionPublishedBy")
  responsibleWorkflowNodes  LogisticWorkflowNode[]             @relation("WorkflowNodeResponsibleUser")
  assignedWorkflowTasks     LogisticWorkflowTask[]             @relation("WorkflowTaskAssignedUser")
  completedWorkflowTasks    LogisticWorkflowTask[]             @relation("WorkflowTaskCompletedBy")
  logisticWorkflowEvents    LogisticWorkflowEvent[]            @relation("WorkflowEventActor")
  createdAt                 DateTime                           @default(now())

  @@map("users")
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Defect {
  id                    String                             @id @default(uuid())
  oemId                 String
  oem                   Company                            @relation("OemDefects", fields: [oemId], references: [id])
  supplierId            String
