  actionKey         String?                 @map("action_key")
  label             String?

  @@unique([workflowVersionId, sourceClientId, targetClientId, actionKey])
  @@index([companyId, workflowVersionId])
  @@map("logistic_workflow_edges")
}

model LogisticWorkflowInstance {
  id                String                         @id @default(uuid())
  companyId         String                         @map("company_id")
  company           Company                        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  definitionId      String                         @map("definition_id")
  definition        LogisticWorkflowDefinition     @relation(fields: [definitionId], references: [id], onDelete: Restrict)
  workflowVersionId String                         @map("workflow_version_id")
  workflowVersion   LogisticWorkflowVersion        @relation(fields: [workflowVersionId], references: [id], onDelete: Restrict)
  subjectType       LogisticWorkflowSubjectType    @map("subject_type")
  subjectId         String                         @map("subject_id")
  currentNodeId     String?                        @map("current_node_id")
  currentNode       LogisticWorkflowNode?          @relation("WorkflowInstanceCurrentNode", fields: [currentNodeId], references: [id], onDelete: Restrict)
  status            LogisticWorkflowInstanceStatus @default(ACTIVE)
  revision          Int                            @default(0)
  context           Json?
  startedAt         DateTime                       @default(now()) @map("started_at")
  completedAt       DateTime?                      @map("completed_at")
  tasks             LogisticWorkflowTask[]
  events            LogisticWorkflowEvent[]

  @@unique([companyId, definitionId, subjectType, subjectId])
  @@index([companyId, subjectType, subjectId, status])
  @@index([companyId, currentNodeId, status])
  @@map("logistic_workflow_instances")
}

model LogisticWorkflowTask {
  id                         String                     @id @default(uuid())
  companyId                  String                     @map("company_id")
  company                    Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  instanceId                 String                     @map("instance_id")
  instance                   LogisticWorkflowInstance   @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  nodeId                     String                     @map("node_id")
  node                       LogisticWorkflowNode       @relation(fields: [nodeId], references: [id], onDelete: Restrict)
  scopeKey                   String                     @default("INSTANCE") @map("scope_key")
  status                     LogisticWorkflowTaskStatus @default(ACTIVE)
  assignedUserId             String?                    @map("assigned_user_id")
  assignedUser               User?                      @relation("WorkflowTaskAssignedUser", fields: [assignedUserId], references: [id], onDelete: SetNull)
  assignedOrganizationUnitId String?                    @map("assigned_organization_unit_id")
  assignedOrganizationUnit   OrganizationUnit?          @relation("WorkflowTaskOrganizationUnit", fields: [assignedOrganizationUnitId], references: [id], onDelete: SetNull)
  allowedActions             String[]                   @default([]) @map("allowed_actions")
  startedAt                  DateTime                   @default(now()) @map("started_at")
  completedAt                DateTime?                  @map("completed_at")
  completedById              String?                    @map("completed_by_id")
  completedBy                User?                      @relation("WorkflowTaskCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  resolution                 String?

  @@index([instanceId, nodeId, scopeKey, status])
  @@index([companyId, status, assignedUserId])
  @@index([companyId, status, assignedOrganizationUnitId])
  @@map("logistic_workflow_tasks")
}

model LogisticWorkflowEvent {
  id         String                   @id @default(uuid())
  companyId  String                   @map("company_id")
  company    Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  instanceId String                   @map("instance_id")
  instance   LogisticWorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  fromNodeId String?                  @map("from_node_id")
  fromNode   LogisticWorkflowNode?    @relation("WorkflowEventFromNode", fields: [fromNodeId], references: [id], onDelete: SetNull)
  toNodeId   String?                  @map("to_node_id")
  toNode     LogisticWorkflowNode?    @relation("WorkflowEventToNode", fields: [toNodeId], references: [id], onDelete: SetNull)
  actionKey  String?                  @map("action_key")
  actorId    String?                  @map("actor_id")
  actor      User?                    @relation("WorkflowEventActor", fields: [actorId], references: [id], onDelete: SetNull)
  message    String?
  createdAt  DateTime                 @default(now()) @map("created_at")

  @@index([companyId, instanceId, createdAt])
  @@map("logistic_workflow_events")
}

