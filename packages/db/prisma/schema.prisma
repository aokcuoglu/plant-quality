model CustomFieldDefinition {
  id            String            @id @default(uuid())
  companyId     String            @map("company_id")
  company       Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  entity        CustomFieldEntity @map("entity_type")
  fieldName     String            @map("field_name")
  label         String?           @map("label")
  placeholder   String?           @map("placeholder")
  fieldType     CustomFieldType   @map("field_type")
  section       String?           @map("section")
  isBuiltIn     Boolean           @default(false) @map("is_built_in")
  visible       Boolean           @default(true) @map("visible")
  required      Boolean           @default(false) @map("required")
  options       Json?             @map("options")
  defaultValue  Json?             @map("default_value")
  validation    Json?             @map("validation")
  visibleInList Boolean           @default(false) @map("visible_in_list")
  order         Int               @default(0) @map("sort_order")
  active        Boolean           @default(true) @map("active")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  @@unique([companyId, entity, fieldName])
  @@index([companyId, entity, active])
  @@index([companyId, entity, order])
  @@map("custom_field_definitions")
}

enum CustomFieldEntity {
  DEFECT
  FIELD_DEFECT
  PPAP_SUBMISSION
  IQC_REPORT
  FMEA
  LOGISTIC_ORDER
}

enum CustomFieldType {
  TEXT
  TEXTAREA
  NUMBER
  DATE
  SELECT
  MULTI_SELECT
  CHECKBOX
  URL
  EMAIL
  USER
}

